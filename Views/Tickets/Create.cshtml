@model TaskDesk.ViewModels.CreateTicketViewModel
@using TaskDesk.Models

@{
    ViewData["Title"] = "Создать заявку";
}

<h1 class="mb-4">Создать заявку</h1>

<div class="row">
    <div class="col-lg-8">
        <form asp-controller="Tickets"
              asp-action="Create"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>

                <input asp-for="Title"
                       class="form-control"
                       maxlength="120" />

                <span asp-validation-for="Title"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="6"
                          maxlength="2000"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Priority" class="form-label"></label>

                <select asp-for="Priority"
                        asp-items="Html.GetEnumSelectList<TicketPriority>()"
                        class="form-select"></select>

                <span asp-validation-for="Priority"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Создать
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Отмена
            </a>
        </form>
    </div>
</div>